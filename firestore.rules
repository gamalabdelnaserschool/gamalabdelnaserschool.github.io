rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // القراءة مفتوحة للزوار، والكتابة لحساب الإدارة فقط
    // غيّر البريد التالي إلى بريد حساب الإدارة الذي أنشأته في Authentication
    match /{col}/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "opaidamazed@gmail.com";
    }
  }
}
